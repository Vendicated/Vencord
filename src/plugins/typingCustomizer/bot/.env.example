# Copy this file to .env and fill it in

# Required. Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Registers /set and /reset in this guild (instant) instead of globally
GUILD_ID=

# Optional. HTTP port the JSON files are served on, bound to 127.0.0.1
PORT=6523

# Optional. Where the <userId>.json files are written
DATA_DIR=./data
