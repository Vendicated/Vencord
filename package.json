{
    "name": "vencord",
    "version": "1.15.16",
    "private": "true",
    "description": "The cutest Discord client mod",
    "homepage": "https://github.com/Vendicated/Vencord#readme",
    "bugs": {
        "url": "https://github.com/Vendicated/Vencord/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": "Vendicated",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vendicated/Vencord.git"
    },
    "scripts": {
        "build": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs",
        "buildStandalone": "pnpm build --standalone",
        "buildWeb": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/runInstaller.mjs -- --install",
        "uninject": "node scripts/runInstaller.mjs -- --uninstall",
        "lint": "oxlint",
        "fmt": "oxfmt \"**/*.{css,html,json,yml,yaml}\"",
        "fmt:check": "pnpm fmt --check",
        "lint:fix": "pnpm lint --fix",
        "test": "pnpm test:ts && pnpm buildStandalone && pnpm buildWebStandalone && pnpm lint && pnpm fmt:check && pnpm generatePluginJson",
        "test:ts": "tsc --noEmit",
        "bump": "./scripts/bump.sh"
    },
    "dependencies": {
        "@intrnl/xxhash64": "catalog:",
        "@vap/core": "catalog:",
        "@vap/shiki": "catalog:",
        "@vencord/monaco-editor": "catalog:",
        "fflate": "catalog:",
        "gifenc": "catalog:"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "catalog:",
        "@types/chrome": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/yazl": "catalog:",
        "@vencord/discord-types": "workspace:",
        "diff": "catalog:",
        "esbuild": "catalog:",
        "eslint-plugin-path-alias": "catalog:",
        "eslint-plugin-simple-header": "catalog:",
        "eslint-plugin-simple-import-sort": "catalog:",
        "html-minifier-terser": "catalog:",
        "lodash": "catalog:",
        "moment": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "p-limit": "catalog:",
        "puppeteer-core": "catalog:",
        "standalone-electron-types": "catalog:",
        "svgo": "catalog:",
        "ts-patch": "catalog:",
        "ts-pattern": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "typescript-transform-paths": "catalog:",
        "zip-local": "catalog:"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.15.0"
}
